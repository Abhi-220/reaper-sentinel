# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
.env
.venv/
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# --- IDE / Editor Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS Specific ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & Reports ---
logs/
*.log
data/reports/
data/feedback.json

# --- Streamlit & Cache ---
.streamlit/
.streamlit/secrets.toml
.cache/
__cache__/

# --- Notebooks / Outputs ---
*.ipynb_checkpoints/
*.nbconvert/

# --- Build / Dist ---
build/
dist/
*.spec

# --- Docker ---
*.pid
*.tar
*.bak
.dockerignore
docker-compose.override.yml

# --- Local Credentials ---
*.env
.env.*
config.yaml
config.json

# --- Ollama / Models ---
*.bin
models/
model_cache/

# --- Misc ---
tmp/
temp/
*.tmp
